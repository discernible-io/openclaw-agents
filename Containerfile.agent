# Agent runtime image: OpenClaw gateway + Himalaya + near-cli-rs + Chromium + seeded plugins.
# Build: podman build -f Containerfile.agent -t openclaw-agent:local .
# Args: --build-arg OPENCLAW_BASE_IMAGE=... --build-arg HIMALAYA_ARCH=x86_64-linux
#       --build-arg NEAR_CLI_RS_VERSION=v0.29.0 --build-arg NEAR_CLI_RS_TARGET=x86_64-unknown-linux-gnu

ARG OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.9.7-slim
ARG OPENCLAW_GATEWAY_VERSION=2026.9.7
ARG HIMALAYA_VERSION=v1.2.0
ARG HIMALAYA_ARCH=x86_64-linux
ARG NEAR_CLI_RS_VERSION=v0.29.0
ARG NEAR_CLI_RS_TARGET=x86_64-unknown-linux-gnu
# Space-separated npm specs installed into the image (seeded into agent homes at start).
ARG OPENCLAW_BUNDLED_PLUGINS="@openclaw/discord@2026.9.7"

FROM ${OPENCLAW_BASE_IMAGE}

# ARGs before FROM are not visible in RUN — re-declare after FROM.
ARG HIMALAYA_VERSION
ARG HIMALAYA_ARCH
ARG NEAR_CLI_RS_VERSION
ARG NEAR_CLI_RS_TARGET
ARG OPENCLAW_GATEWAY_VERSION
ARG OPENCLAW_BUNDLED_PLUGINS

USER root
# CVE-2026-111497: bookworm-security libbrotli, and Node.js 24.22.1. The
# 2026.9.7-slim base ships Node 24.21.0, whose embedded Brotli decoder is
# 1.2.0. Replacing the binary is required; apt does not upgrade that copy.
ARG NODE_VERSION=24.22.1
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl sudo chromium jq xz-utils \
      'libbrotli1>=1.0.9-2+deb12u1' \
 && dpkg --compare-versions "$(dpkg-query -W -f '$${Version}' libbrotli1)" ge '1.0.9-2+deb12u1' \
 && machine="$(uname -m)" \
 && if [ "$machine" = x86_64 ]; then node_arch=linux-x64; node_sha=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6; \
    elif [ "$machine" = aarch64 ]; then node_arch=linux-arm64; node_sha=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e; \
    else echo "unsupported architecture: $machine" >&2; exit 1; fi \
 && curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-${node_arch}.tar.xz" \
 && echo "${node_sha}  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm -f /tmp/node.tar.xz \
 && node -e 'const [maj,min,pat]=process.versions.brotli.split(".").map(Number); if (!(maj>1 || (maj===1 && min>2) || (maj===1 && min===2 && pat>=1))) { console.error(process.version, process.versions.brotli); process.exit(1); }' \
 && curl -fsSL -o /tmp/himalaya.tgz \
      "https://github.com/pimalaya/himalaya/releases/download/${HIMALAYA_VERSION}/himalaya.${HIMALAYA_ARCH}.tgz" \
 && tar -xzf /tmp/himalaya.tgz -C /usr/local/bin \
 && chmod 755 /usr/local/bin/himalaya \
 && himalaya --version \
 && curl -fsSL -o /tmp/near-cli-rs.tgz \
      "https://github.com/near/near-cli-rs/releases/download/${NEAR_CLI_RS_VERSION}/near-cli-rs-${NEAR_CLI_RS_TARGET}.tar.gz" \
 && tar -xzf /tmp/near-cli-rs.tgz -C /tmp \
 && install -m 755 "/tmp/near-cli-rs-${NEAR_CLI_RS_TARGET}/near" /usr/local/bin/near \
 && near --version \
 && chromium --version \
 && jq --version \
 && rm -rf /tmp/himalaya.tgz /tmp/near-cli-rs.tgz "/tmp/near-cli-rs-${NEAR_CLI_RS_TARGET}" \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /app/openclaw.mjs /openclaw.mjs \
 && ln -sf /usr/bin/chromium /usr/bin/chromium-browser \
 && echo "node ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/node \
 && chmod 440 /etc/sudoers.d/node

# Pre-install downloadable plugins (e.g. Discord) at a path outside the bind-mounted home.
RUN mkdir -p /opt/identyclaw/plugin-seed \
 && for spec in ${OPENCLAW_BUNDLED_PLUGINS}; do \
      OPENCLAW_STATE_DIR=/opt/identyclaw/plugin-seed \
        node /app/openclaw.mjs plugins install "$spec" --pin --accept-capabilities; \
    done \
 && chown -R node:node /opt/identyclaw

COPY scripts/container-entrypoint.sh /opt/identyclaw/entrypoint.sh
COPY scripts/patch-openclaw-tool-result-images.mjs /opt/identyclaw/patch-openclaw-tool-result-images.mjs
COPY scripts/patch-identyclaw-request-body.mjs /opt/identyclaw/patch-identyclaw-request-body.mjs
COPY scripts/lib-openclaw-model-routing.py /opt/identyclaw/lib-openclaw-model-routing.py
COPY scripts/patch-openclaw-model-routing.py /opt/identyclaw/patch-openclaw-model-routing.py
COPY scripts/lib-openclaw-cache-config.mjs /opt/identyclaw/lib-openclaw-cache-config.mjs
COPY scripts/patch-openclaw-cache-config.mjs /opt/identyclaw/patch-openclaw-cache-config.mjs
COPY scripts/repair-openclaw-session-headers.py /opt/identyclaw/repair-openclaw-session-headers.py
COPY scripts/repair-openclaw-session-canonical.sh /opt/identyclaw/repair-openclaw-session-canonical.sh
RUN chmod 755 /opt/identyclaw/entrypoint.sh \
      /opt/identyclaw/patch-openclaw-tool-result-images.mjs \
      /opt/identyclaw/patch-identyclaw-request-body.mjs \
      /opt/identyclaw/patch-openclaw-model-routing.py \
      /opt/identyclaw/patch-openclaw-cache-config.mjs \
      /opt/identyclaw/repair-openclaw-session-headers.py \
      /opt/identyclaw/repair-openclaw-session-canonical.sh \
 && chmod 644 /opt/identyclaw/lib-openclaw-model-routing.py \
      /opt/identyclaw/lib-openclaw-cache-config.mjs \
      /opt/identyclaw/repair-openclaw-session-headers.py

USER node
ENTRYPOINT ["/opt/identyclaw/entrypoint.sh"]
CMD ["node", "dist/index.js", "gateway", "--bind", "lan", "--port", "18789"]
