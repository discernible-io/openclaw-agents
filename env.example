# Copy to env.local and fill in (chmod 600 env.local). Never commit env.local.
#
# cp env.example env.local && chmod 600 env.local

# OpenClaw image from GHCR (see https://github.com/openclaw/openclaw/pkgs/container/openclaw)
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.5.27-slim
OPENCLAW_LOCAL_IMAGE=localhost/openclaw-himalaya:local
# npm specs baked into the image (seeded into each agent on first start)
# Comma/space-separated plugins baked into the image (see Containerfile.himalaya).
# Per-agent IdentyClaw plugin is installed from ClawHub on bootstrap when near-credentials exist.
OPENCLAW_BUNDLED_PLUGINS=@openclaw/discord

# Himalaya CLI release (https://github.com/pimalaya/himalaya/releases)
HIMALAYA_VERSION=v1.2.0

# Migadu mailboxes on identyclaw.com
AGENT_A_EMAIL=agent-a@identyclaw.com
AGENT_B_EMAIL=agent-b@identyclaw.com
AGENT_C_EMAIL=agent-c@identyclaw.com
AGENT_A_DISPLAY_NAME="Identyclaw Agent A"
AGENT_B_DISPLAY_NAME="Identyclaw Agent B"
AGENT_C_DISPLAY_NAME="Identyclaw Agent C"

# Mailbox passwords (or leave empty and set via ./identyclaw.sh set-password agent-a)
AGENT_A_PASSWORD=
AGENT_B_PASSWORD=
AGENT_C_PASSWORD=

# Optional Instagram credentials (synced to secrets/ on bootstrap; agent-c manages Mundo En Blanco)
# AGENT_C_INSTAGRAM_USERNAME=mundo_en_blanco
# AGENT_C_INSTAGRAM_PASSWORD=

# Host publish (keep 127.0.0.1 unless you know you need LAN exposure)
PUBLISH_HOST=127.0.0.1

# Podman network for agent-to-agent traffic (Control UI stays on 127.0.0.1)
IDENTYCLAW_NETWORK=identyclaw-net

# A2A peer group (space-separated agent ids; requires secrets/near-credentials/*.json per agent)
A2A_PEER_AGENTS=agent-a agent-b
# A2A IDC fork repo (cloned and built on first start when near-credentials exist)
A2A_PLUGIN_REPO=https://github.com/discernible-io/openclaw-a2a-idc-plugin.git
# IdentyClaw API issuer for inbound JWT validation (synced to openclaw.json on bootstrap)
IDENTYCLAW_API_BASE_URL=https://api.identyclaw.com

# Optional public base URLs for Agent Card discovery behind a reverse proxy.
# When unset, peers use container DNS (http://openclaw-agent-a:18789, etc.).
AGENT_A_A2A_PUBLIC_BASE_URL=
AGENT_B_A2A_PUBLIC_BASE_URL=
AGENT_C_A2A_PUBLIC_BASE_URL=

# NEAR Passport credentials for RODiT outbound login are synced from
# secrets/near-credentials/*.json into each agent's .env as:
#   IDENTYCLAW_ACCOUNT_ID, IDENTYCLAW_NEAR_PRIVATE_KEY, IDENTYCLAW_BASE_URL
# When A2A is enabled, bootstrap also sets LOG_LEVEL=error and
# SUPPRESS_NO_CONFIG_WARNING=true to keep @rodit/rodit-auth-be JSON off the chat TUI.

# Ports (must differ per agent)
AGENT_A_GATEWAY_PORT=18789
AGENT_A_BRIDGE_PORT=18790
AGENT_B_GATEWAY_PORT=18791
AGENT_B_BRIDGE_PORT=18792
AGENT_C_GATEWAY_PORT=18793
AGENT_C_BRIDGE_PORT=18794
