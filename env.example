# Template for host runtime config — NOT read from the git checkout.
#
#   ./identyclaw.sh init
# creates ../openclaw-agents-app/env.local from this file (chmod 600).
# Override app root: export IDENTYCLAW_APP_DIR=/path/to/openclaw-agents-app

# OpenClaw image from GHCR (see https://github.com/openclaw/openclaw/pkgs/container/openclaw)
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-slim
# Must match the gateway tag in OPENCLAW_BASE_IMAGE (used to pin bundled Discord).
OPENCLAW_GATEWAY_VERSION=2026.7.1
OPENCLAW_LOCAL_IMAGE=localhost/openclaw-agent:local
# npm specs baked into the image (seeded into each agent on first start)
# Comma/space-separated plugins baked into the image (see Containerfile.agent).
# Per-agent integrations installed on start (see workspace/IDENTYCLAW.md):
#   ClawHub skill:  identyclaw  → https://clawhub.ai/identyclaw/identyclaw
#   IdentyClaw plugin: IDENTYCLAW_CLAWHUB_PLUGIN (deploy-pod.sh / ./identyclaw.sh upgrade-plugins)
#   A2A plugin:     IDENTYCLAW_CLAWHUB_A2A_PLUGIN (when secrets/near-credentials/*.json exists)
#   Webhooks plugin: IDENTYCLAW_CLAWHUB_WEBHOOKS_PLUGIN (when secrets/near-credentials/*.json exists)
# Pin Discord to OPENCLAW_GATEWAY_VERSION (bare @openclaw/discord is auto-pinned at image build).
OPENCLAW_BUNDLED_PLUGINS=@openclaw/discord@2026.7.1

# OpenClaw LLM provider: openrouter (default) or opencode (OpenCode Zen + Go catalogs).
# OPENCLAW_LLM_PROVIDER=opencode
#
# Model chain (synced to each agent openclaw.json on bootstrap).
# Defaults depend on OPENCLAW_LLM_PROVIDER; override any model below.
#
# openrouter — paid defaults (free :free tiers 429/idle under parallel agent load).
# Avoid openrouter/auto and openrouter/free as primary — they auto-pick backends that often
# 400 on OpenClaw tool schemas ("provider rejected the request schema or tool payload").
OPENCLAW_MODEL_PRIMARY=openrouter/deepseek/deepseek-v4-flash
OPENCLAW_MODEL_FALLBACK_1=openrouter/qwen/qwen3-coder
OPENCLAW_MODEL_FALLBACK_2=openrouter/google/gemini-2.5-flash
#
# opencode — curated Zen catalog + Go catalog fallback (set OPENCLAW_LLM_PROVIDER=opencode):
# OPENCLAW_MODEL_PRIMARY=opencode/claude-opus-4-6
# OPENCLAW_MODEL_FALLBACK_1=opencode/gpt-5.5
# OPENCLAW_MODEL_FALLBACK_2=opencode-go/kimi-k2.6
# Store key: ./identyclaw.sh set-opencode-key agent-b sk-...
# Or: OPENCODE_API_KEY=sk-... ./identyclaw.sh set-opencode-key agent-b
# Agent turn cap (whole run) + provider idle/request watchdog. SLC login/join/tool loops often need 600s+.
OPENCLAW_AGENT_TIMEOUT_SECONDS=600
OPENCLAW_MODEL_PROVIDER_TIMEOUT_SECONDS=120
# Wait before retrying a rate-limited model (ms); avoids immediate paid fallback.
OPENCLAW_FALLBACK_SKIP_TTL_MS=60000
# Thinking/reasoning effort synced to agents.defaults.thinkingDefault (off|minimal|low|medium|high|…).
# Keep off for deepseek-v4-flash — provider default is high and slows tool loops.
OPENCLAW_THINKING_DEFAULT=off
# OpenRouter sticky routing: one fixed session_id (+ x-session-id header) for the whole fleet.
# Pins backends so prompt/KV cache stays warm (see OpenRouter prompt-caching sticky routing).
# Set to off (or false) to disable injection. Keep under 256 chars.
OPENCLAW_OPENROUTER_SESSION_ID=identyclaw
# Prompt-cache observability: diagnostics.cacheTrace in openclaw.json + ./identyclaw.sh cache-stats.
# Set to 0 to disable cacheTrace writes (cache-stats still reads session usage when present).
OPENCLAW_CACHE_TRACE=1
# Stuck-session recovery: warn/abort when a tool shows no progress (OpenClaw defaults ~2m/~6m).
# Keep ABORT >= agent turn budget so long exec is not force-killed mid-turn.
OPENCLAW_STUCK_SESSION_WARN_MS=300000
OPENCLAW_STUCK_SESSION_ABORT_MS=900000

# Memory backend synced to each agent openclaw.json on bootstrap (survives redeploy).
# Requires @tobilu/qmd in the agent image (Containerfile.agent QMD_NPM_SPEC).
# QMD session recall indexes transcripts for memory_search (requires session-memory hook).
# Recommended cost/speed/learning stack: QMD BM25 (searchMode=search) + session recall +
# memory-core dreaming on (nightly) + Active Memory left off (no per-turn recall LLM).
IDENTYCLAW_MEMORY_BACKEND=qmd
IDENTYCLAW_QMD_SESSION_RECALL=1
IDENTYCLAW_QMD_SESSION_RETENTION_DAYS=14
IDENTYCLAW_DREAMING_ENABLED=1
IDENTYCLAW_DREAMING_FREQUENCY=0 3 * * *

# Session store maintenance (session.maintenance) synced on bootstrap — keep-forever defaults.
# mode=warn reports only (no deletes); enforce applies pruneAfter / maxEntries / disk budget.
# maxDiskBytes=false omits the key (disables disk eviction). Set a size like 10gb to enable.
# OpenClaw accepts string|number only — boolean false in openclaw.json is invalid.
IDENTYCLAW_SESSION_MAINTENANCE_MODE=warn
IDENTYCLAW_SESSION_MAINTENANCE_PRUNE_AFTER=36500d
IDENTYCLAW_SESSION_MAINTENANCE_MAX_ENTRIES=100000
IDENTYCLAW_SESSION_MAINTENANCE_MAX_DISK_BYTES=false

# Himalaya CLI release (https://github.com/pimalaya/himalaya/releases)
HIMALAYA_VERSION=v1.2.0

# near-cli-rs release baked into the agent image (https://github.com/near/near-cli-rs/releases)
NEAR_CLI_RS_VERSION=v0.29.0

# Migadu mailboxes on identyclaw.com
AGENT_A_EMAIL=agent-a@identyclaw.com
AGENT_C_EMAIL=agent-c@identyclaw.com
AGENT_E_EMAIL=agent-e@identyclaw.com
AGENT_A_DISPLAY_NAME="Identyclaw Agent A"
AGENT_C_DISPLAY_NAME="Identyclaw Agent C"
AGENT_E_DISPLAY_NAME="Identyclaw Agent E"

# Optional per-agent SMTP override (Migadu UI lists 465+TLS; default is 587+start-tls for Himalaya)
# AGENT_F_SMTP_PORT=465
# AGENT_F_SMTP_ENCRYPTION=tls
# Pod deploy: pin smtp.migadu.com to IPv4 when IPv6 SMTP is reset (default mta1 37.59.57.117)
# MIGADU_SMTP_IPV4=37.59.57.117

# Mailbox passwords (or leave empty and set via ./identyclaw.sh set-password agent-a)
AGENT_A_PASSWORD=
AGENT_C_PASSWORD=
AGENT_E_PASSWORD=

# Optional X/Twitter credentials (synced to secrets/ on bootstrap; enables hourly DM polling)
# AGENT_E_TWITTER_USERNAME=agent-e@example.com
# AGENT_E_TWITTER_PASSWORD=

# Optional LLM inbox heartbeat (concierge — re-applied on bootstrap/restart/rebuild)
# ./identyclaw.sh enable-inbox-check agent-a 1h  # or set env + redeploy:
# IDENTYCLAW_ENABLE_INBOX_HEARTBEAT=1
# IDENTYCLAW_INBOX_HEARTBEAT_INTERVAL=1h
# AGENT_L_INBOX_HEARTBEAT_INTERVAL=1h
# AGENT_L_ENABLE_INBOX_HEARTBEAT=1

# Federated game API endpoint list for the IdentyClaw plugin (apiEndpoints).
# OpenClaw agents play via skill.md paths + identyclaw_request after
# identyclaw_ensure_session — remote MCP is NOT wired (see README: OpenClaw MCP
# cannot attach the plugin's federated JWT). Peer MCP tools remain authenticated on-server.
IDENTYCLAW_API_ENDPOINTS=https://slc.discernible.io:8443
# SLC unattended heartbeat (real HEARTBEAT.md slc-game task; stubs stale local playbooks).
# Or: ./identyclaw.sh enable-slc-heartbeat <agent-id> [interval] then restart.
# IDENTYCLAW_ENABLE_SLC_HEARTBEAT=1
# IDENTYCLAW_SLC_HEARTBEAT_INTERVAL=10m
# AGENT_B_ENABLE_SLC_HEARTBEAT=1

# X/Twitter via ClawHub bird-twitter (free — session cookies, not paid API)
# https://clawhub.ai/cyzi/bird-twitter
# IDENTYCLAW_CLAWHUB_TWITTER_SKILL=bird-twitter
# AGENT_E_TWITTER_AUTH_TOKEN=
# AGENT_E_TWITTER_CT0=

# LinkedIn via ClawLink + ClawHub linkedin-social (OAuth — no LinkedIn API keys in chat)
# https://clawhub.ai/hith3sh/linkedin-social
# IDENTYCLAW_CLAWHUB_LINKEDIN_SKILL=linkedin-social
# IDENTYCLAW_CLAWHUB_CLAWLINK_PLUGIN=clawhub:clawlink-plugin

# Host publish for standalone dev (identyclaw.sh start). Main-tier pod uses nginx TLS.
PUBLISH_HOST=127.0.0.1

# --- App layout (all runtime config + agent state live here, not in the repo) ---
# IDENTYCLAW_APP_DIR=          # default: ../openclaw-agents-app (sibling of git clone)
# IDENTYCLAW_AGENT_STATE_ROOT= # default: ${IDENTYCLAW_APP_DIR}/agents

# --- Deploy mode: standalone (identyclaw.sh start) or pod (nginx TLS ingress) ---
IDENTYCLAW_DEPLOY_MODE=standalone
# Agents on THIS host — controls start/stop/deploy/test (space-separated ids).
# Trim for single-agent hosts or extend when you add more agent blocks below.
# AGENT_IDS=agent-a
# AGENT_IDS=agent-a agent-c agent-e
# Default when unset: agent-a agent-c agent-e
# Optional override when A2A_PEER_AGENTS lists multiple peers:
# Process env export overrides this value (multi-peer loops); use ./identyclaw.sh test-all-peers for full sweep.
# IDENTYCLAW_PEER_TOKEN_ID=PeerTokenId12
# Pod ingress — IDENTYCLAW_INGRESS_PORT (7443 for all tiers; infra public list is 7443 only):
# IDENTYCLAW_DEPLOY_MODE=pod
IDENTYCLAW_INGRESS_PORT=7443
# Development tier (nginx nginx.development.conf, port 7443):
#   agent-a: https://agent-a.dev.identyclaw.com:7443
#   agent-c: https://agent-c.dev.identyclaw.com:7443
#   agent-e: https://agent-e.dev.identyclaw.com:7443
# Example env.local for agent-a on a single-agent dev host:
#   AGENT_A_PUBLIC_HOST=agent-a.dev.identyclaw.com
#   AGENT_A_INGRESS_PORT=7443   # or IDENTYCLAW_INGRESS_PORT=7443
#   AGENT_A_A2A_PUBLIC_BASE_URL=https://agent-a.dev.identyclaw.com:7443
# Example for agent-c on another host:
#   AGENT_C_PUBLIC_HOST=agent-c.dev.identyclaw.com
#   AGENT_C_INGRESS_PORT=7443
#   AGENT_C_A2A_PUBLIC_BASE_URL=https://agent-c.dev.identyclaw.com:7443
# Main tier:
AGENT_A_PUBLIC_HOST=agent-a.identyclaw.com
AGENT_C_PUBLIC_HOST=agent-c.identyclaw.com
AGENT_E_PUBLIC_HOST=agent-e.identyclaw.com
# Optional per-agent ingress port (defaults to IDENTYCLAW_INGRESS_PORT). Use when agents share a host on different tiers.
# AGENT_D_INGRESS_PORT=7443
# Optional extra TLS SAN for remote peer ingress (split-host layouts):
# IDENTYCLAW_INGRESS_ALT_HOST=webhook.example.com

# Podman network for agent-to-agent traffic (Control UI stays on 127.0.0.1)
IDENTYCLAW_NETWORK=identyclaw-net

# A2A peer group — Passport token_id values only (space-separated).
# Gateway URLs resolve at bootstrap and runtime via resolvePeersByTokenId:
#   IdentyClaw API GET /full → metadata.webhook_url (on-chain NEAR fallback).
# Deprecated token_ids may remain as bootstrap hints; GET /api/agents registrations
# at the same gateway win in tests and outbound.agents (e.g. Andrew cfbkbhzdzflk over lmsfckzncdbw).
# Do not set A2A_PEER_URLS unless you need a static override for a specific peer.
A2A_PEER_AGENTS=
# Peers excluded from constitution tests (still in A2A_PEER_AGENTS for discovery/bootstrap).
# Use for external peers on pre-0.1.5 webhook stacks that reject outbound with HTTP 401.
# A2A_TEST_EXCLUDE_PEERS=cdbvzmckzhlk cnckcfcjljsv
# Test allowlist: when set, constitution peer suites target ONLY these token_ids after
# API discovery (local-host token_ids stay covered by LOCAL suites, skipped as peers).
# Prefer a same-host peer that runs webhooks 0.1.5 when external peers fail outbound P2P.
# A2A_TEST_ONLY_PEERS=lmsfckzncdbw
# Constitution suite skips (space-separated) — speeds up test-all-agents while debugging failures.
#   a2a              discovery + unauthenticated /a2a probe (local + peer)
#   a2a-auth         P2P JWT on /a2a
#   auth-boundaries  channel isolation + mutual P2P binding
#   webhook          unsigned POST /hooks/wake smoke only (outbound + testhola still run)
#   webhook-all      entire local test-webhook suite
#   webhook-p2p      P2P webhook send/receive per peer
#   mail             himalaya INBOX list (local)
#   mail-hola        reciprocal email HOLA per peer (or SKIP_MAIL_HOLA=1)
# Inbound webhook-p2p polls peer /hooks/_receipts after live A2A message/send (default 180s).
# WEBHOOK_P2P_INBOUND_POLL_TIMEOUT_MS=180000
# WEBHOOK_P2P_SMOKE_POLL_SEC=2
# Enable on every host (including remote peers): ./identyclaw.sh enable-a2a-webhook-smoke-responder
# Reciprocal mail HOLA (peer emails us via A2A instruction): ./identyclaw.sh enable-a2a-hola-smoke-responder
# Example — skip passing suites, keep a2a-auth + auth-boundaries + signed webhooks:
# CONSTITUTION_SKIP_SUITES=a2a a2a-messaging webhook mail mail-hola
# Example (replace with real 12-char Passport token_ids from probe / IDENTITYCLAW.md):
# A2A_PEER_AGENTS=PeerOneTokenId PeerTwoTokenId
# Optional static override only (normally leave unset):
# A2A_PEER_URLS={"PeerOneTokenId":"https://agent-c.identyclaw.com:7443"}
# Or learn peers from inbound P2P logins: ./identyclaw.sh sync-a2a-peers (after IDENTYCLAW_A2A_DYNAMIC_PEERS_FROM_JWT=1)
# IdentyClaw A2A plugin (ClawHub; plugin id identyclaw-a2a — installed when near-credentials exist)
IDENTYCLAW_CLAWHUB_A2A_PLUGIN=clawhub:@identyclaw/openclaw-a2a-plugin@0.4.11
# IdentyClaw webhooks plugin — RODiT-signed /hooks/* ingress + send_rodit_webhook (requires NEAR creds)
IDENTYCLAW_CLAWHUB_WEBHOOKS_PLUGIN=clawhub:@identyclaw/openclaw-identyclaw-webhooks-plugin@0.1.9
# Optional override — default comes from Passport metadata.subjectuniqueidentifier_url (RoditClient).
# IDENTYCLAW_API_BASE_URL=https://api.identyclaw.com
# RODiT NEAR contract on mainnet (synced to each agent .env as NEAR_CONTRACT_ID for @rodit/rodit-auth-be)
IDENTYCLAW_NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
# Dedicated NEAR RPC (GetBlock, QuickNode, etc.) — synced to each agent .env as NEAR_RPC_URL.
# Default when unset: https://rpc.mainnet.fastnear.com (public; may rate-limit).
IDENTYCLAW_NEAR_RPC_URL=https://go.getblock.io/YOUR_GETBLOCK_API_KEY
# IdentyClaw tools plugin — identity/HOLA (GitHub; plugin id identyclaw-tools)
# ClawHub alternative: clawhub:@identyclaw/openclaw-identyclaw-plugin@1.8.3
# Local staged checkout (if git: install is blocked): /home/node/.openclaw/.identyclaw-plugin-build
IDENTYCLAW_CLAWHUB_PLUGIN=git:github.com/discernible-io/openclaw-identyclaw-plugin@main
IDENTYCLAW_CLAWHUB_SKILL=identyclaw
# Prefer skill bundled with identyclaw-tools (GitHub). ClawHub may lag; leave unset so
# upgrade-plugins installs from the plugin skill/ tree when present.
# IDENTYCLAW_CLAWHUB_SKILL_VERSION=1.6.2
IDENTYCLAW_CLAWHUB_SKILL_VERSION=

# TLS for pod ingress: ./identyclaw.sh generate-certs (self-signed; SANs from AGENT_*_PUBLIC_HOST).
# Mutual auth uses RODiT JWT — not TLS client certificates. Peers may use curl -k or skip TLS verify.

# Public HTTPS base URLs for Control UI + A2A Agent Card discovery (nginx ingress).
# inbound.auth.audience = own passport owner_id (probed via probe_rodit_own_owner_id).
# Override probe when needed:
# IDENTYCLAW_A2A_JWT_AUDIENCE=YOUR_PASSPORT_OWNER_ID_HEX
# AGENT_D_A2A_AUDIENCE=...
# Legacy AGENT_*_P2P_AUDIENCE / IDENTYCLAW_P2P_AUDIENCE still map to audience.
# Removed (ignored with warning): IDENTYCLAW_A2A_INBOUND_AUTH_MODE, IDENTYCLAW_A2A_OUTBOUND_AUTH_MODE
# Open P2P: any IdentyClaw Passport holder can P2P-login and POST /a2a; peers learned from inbound JWT.
# Sets roditLogin promiscuous + outbound.resolvePeersByTokenId/persistResolvedPeers when IDENTYCLAW_A2A_OPEN_P2P=1.
# A2A_PEER_AGENTS lists peer token_ids for smoke tests; URLs come from API (not A2A_PEER_URLS).
# IDENTYCLAW_A2A_OPEN_P2P=1
# Recommended for API peer URL resolution without promiscuous inbound:
IDENTYCLAW_A2A_DYNAMIC_PEERS_FROM_JWT=1
# List remote agent peers from public GET /api/agents (slow — do not enable for deploy).
# Prefer ./identyclaw.sh discover-a2a-peers or constitution suites instead.
IDENTYCLAW_A2A_DISCOVER_PEERS_FROM_API=0
AGENT_A_A2A_PUBLIC_BASE_URL=
AGENT_C_A2A_PUBLIC_BASE_URL=
AGENT_E_A2A_PUBLIC_BASE_URL=

# Optional A2A Agent Card overrides (GET /.well-known/agent-card.json).
# CARD_NAME is the published discovery name; DISPLAY_NAME stays the email From: / Himalaya label.
# AGENT_C_CARD_NAME="Concierge"
# AGENT_C_CARD_DESCRIPTION="IdentyClaw concierge by Discernible.io — answers enrollment, HOLA verification, and agent collaboration questions via email and A2A."

# NEAR Passport (RODiT) — place implicit-account JSON per agent (canonical for peer sync):
#   ../openclaw-agents-app/agents/<id>/secrets/near-credentials/<implicit_account_id>.json
# Legacy (migrated on bootstrap): ../openclaw-agents-app/secrets/<implicit_account_id>.json
# Bootstrap syncs each agent .env automatically:
#   IDENTYCLAW_ACCOUNT_ID, IDENTYCLAW_NEAR_PRIVATE_KEY, IDENTYCLAW_BASE_URL
#   NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
#   RODIT_NEAR_CREDENTIALS_SOURCE=file
#   NEAR_CREDENTIALS_FILE_PATH=/home/node/.openclaw/secrets/near-credentials/<implicit_account_id>.json
# IDENTYCLAW_NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
# inbound.auth.audience is probed via own_rodit.owner_id; override: AGENT_*_A2A_AUDIENCE
# Removed (ignored with warning): IDENTYCLAW_A2A_*_AUTH_MODE env vars
# RoditClient self-configure (default on): when AGENT_*_A2A_PUBLIC_BASE_URL / PUBLIC_HOST /
# INGRESS_PORT are unset, bootstrap probes Passport metadata.webhook_url via getConfigOwnRodit().
# Set IDENTYCLAW_RODIT_SELF_CONFIGURE=0 to require explicit env only.
# IDENTYCLAW_RODIT_SELF_CONFIGURE=1
# Outbound peers include loginBaseUrl from AGENT_*_A2A_PUBLIC_BASE_URL (gateway base, not …/a2a RPC).
# Bootstrap always enables P2P RODiT login (roditLogin + promiscuous).
# When A2A is enabled, bootstrap also sets LOG_LEVEL=error and
# SUPPRESS_NO_CONFIG_WARNING=true to keep @rodit/rodit-auth-be JSON off the chat TUI.
# Dev peers with self-signed TLS: bootstrap sets outbound.tlsSkipVerify=true; also set
# A2A_TLS_SKIP_VERIFY=1 (default) so rodit-auth-be Node fetch accepts peer certs.
# Main tier with CA-signed peer ingress: A2A_TLS_SKIP_VERIFY=0
# IdentyClaw webhooks plugin (ClawHub; requires NEAR creds):
#   https://clawhub.ai/plugins/@identyclaw/openclaw-identyclaw-webhooks-plugin
#   (/hooks/wake, /hooks/agent). Test: ./identyclaw.sh test-webhook agent-a
# P2P webhooks (peer signs → your /hooks/*): ./identyclaw.sh test-webhook-p2p agent-c agent-a
# Also in test-a2a-p2p-suite.mjs / test-webhook-p2p (send_rodit_webhook via outbound.agents)
# Bidirectional P2P tests need peer NEAR creds under agents/<peer-id>/secrets/near-credentials/

# Ports (must differ per agent)
# Standalone dev: AGENT_*_GATEWAY_PORT is the host publish port (identyclaw.sh start).
# Pod mode: public HTTPS ingress uses IDENTYCLAW_INGRESS_PORT (7443);
# gateways listen on pod-internal 18789/18793/18797 — :nginx proxies :7443 → :18789, etc.
AGENT_A_GATEWAY_PORT=18789
AGENT_A_BRIDGE_PORT=18790
AGENT_C_GATEWAY_PORT=18793
AGENT_C_BRIDGE_PORT=18794
AGENT_E_GATEWAY_PORT=18797
AGENT_E_BRIDGE_PORT=18798
