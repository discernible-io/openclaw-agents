# Template for host runtime config — NOT read from the git checkout.
#
#   ./identyclaw.sh init
# creates ../identyclaw-agents-app/env.local from this file (chmod 600).
# Override app root: export IDENTYCLAW_APP_DIR=/path/to/identyclaw-agents-app
#
# Placeholder nomenclature (replace before production deploy):
#   agent-namenotset             — example agent slug (rename with AGENT_* prefix)
#   agent-domain-not-set.example.com — public hostname / TLS SAN
#   GETBLOCK-API-KEY-NOT-SET    — NEAR RPC provider key
#   implicit-account-id-not-set — 64-char NEAR implicit account (Passport credentials filename)

# OpenClaw image from GHCR (see https://github.com/openclaw/openclaw/pkgs/container/openclaw)
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.6.10-slim
OPENCLAW_GATEWAY_VERSION=2026.6.10
OPENCLAW_LOCAL_IMAGE=localhost/openclaw-himalaya:local
OPENCLAW_BUNDLED_PLUGINS=@openclaw/discord@2026.6.10

OPENCLAW_MODEL_PRIMARY=openrouter/auto
OPENCLAW_MODEL_FALLBACK_1=openrouter/deepseek/deepseek-v4-flash
OPENCLAW_MODEL_FALLBACK_2=openrouter/moonshotai/kimi-k2.5
OPENCLAW_AGENT_TIMEOUT_SECONDS=60
OPENCLAW_MODEL_PROVIDER_TIMEOUT_SECONDS=30
OPENCLAW_FALLBACK_SKIP_TTL_MS=60000

IDENTYCLAW_MEMORY_BACKEND=builtin
IDENTYCLAW_QMD_SESSION_RECALL=1
IDENTYCLAW_QMD_SESSION_RETENTION_DAYS=14

# Knowledge base: local product/service docs in workspace/knowledge/ (indexed by QMD).
# Network-published content stays on IdentyClaw — use identyclaw_list_resources / identyclaw_get_resource.
IDENTYCLAW_KNOWLEDGE_ENABLED=1
IDENTYCLAW_KNOWLEDGE_PATH=./knowledge

HIMALAYA_VERSION=v1.2.0

# --- Required in env.local (replace placeholders) ---
IDENTYCLAW_NEAR_RPC_URL=https://go.getblock.io/GETBLOCK-API-KEY-NOT-SET

# --- Human-facing IdentyClaw service mailboxes (referenced in agent workspace docs) ---
IDENTYCLAW_SERVICE_CONTACT_SALES=sales@identyclaw.com
IDENTYCLAW_SERVICE_CONTACT_SUPPORT=support@identyclaw.com

# --- Agent slug (rename slug + AGENT_* env prefix together) ---
AGENT_IDS=agent-namenotset

# Migadu mailbox for this agent (IMAP imap.migadu.com:993 TLS, SMTP smtp.migadu.com:587 STARTTLS).
# Password: leave empty here; run ./identyclaw.sh set-password agent-namenotset after Migadu provisioning.
AGENT_NAMENOTSET_EMAIL=identyclaw@agenthood.com
AGENT_NAMENOTSET_DISPLAY_NAME=Cornelius
AGENT_NAMENOTSET_SMTP_PORT=587
AGENT_NAMENOTSET_SMTP_ENCRYPTION=start-tls
AGENT_NAMENOTSET_PASSWORD=

# Optional overrides — when unset, bootstrap reads display name + contactUri from Passport
# (RoditClient.getConfigOwnRodit + IdentyClaw API /full) after NEAR creds are present.

IDENTYCLAW_DEPLOY_MODE=pod
# Fallback ingress port when metadata.webhook_url has no port (Passport URL wins when creds exist).
IDENTYCLAW_INGRESS_PORT=9443
# Public HTTPS base comes from Passport metadata.webhook_url (host + port) when NEAR creds exist.
# Register in Passport, e.g. https://agent-domain-not-set.example.com:9443 — no path suffix.
# Optional overrides (unset for turnkey Rodit self-config):
# AGENT_NAMENOTSET_PUBLIC_HOST=agent-domain-not-set.example.com
# AGENT_NAMENOTSET_A2A_PUBLIC_BASE_URL=https://agent-domain-not-set.example.com:9443

PUBLISH_HOST=127.0.0.1

IDENTYCLAW_NETWORK=identyclaw-net

IDENTYCLAW_CLAWHUB_A2A_PLUGIN=clawhub:@identyclaw/openclaw-a2a-plugin@0.4.5
IDENTYCLAW_CLAWHUB_WEBHOOKS_PLUGIN=clawhub:@identyclaw/openclaw-identyclaw-webhooks-plugin@0.1.6
IDENTYCLAW_CLAWHUB_PLUGIN=clawhub:@identyclaw/openclaw-identyclaw-plugin@1.5.2
IDENTYCLAW_CLAWHUB_SKILL=identyclaw
IDENTYCLAW_CLAWHUB_SKILL_VERSION=1.4.0

# --- Chat channels (official OpenClaw) — tokens via identyclaw.sh set-* commands ---
# Cross-provider routing (Telegram ↔ Discord, etc.) is enabled in openclaw.json
# (tools.message.crossContext.allowAcrossProviders). See workspace/CHAT_CHANNELS.md.
# Discord: ./identyclaw.sh set-discord-token agent-namenotset
#   Guild/channel/owner IDs (Developer Mode → copy IDs):
# AGENT_NAMENOTSET_DISCORD_GUILD_ID=
# AGENT_NAMENOTSET_DISCORD_CHANNEL_ID=
# AGENT_NAMENOTSET_DISCORD_OWNER_ID=
# AGENT_NAMENOTSET_TELEGRAM_OWNER_ID=
# Or global: IDENTYCLAW_DISCORD_GUILD_ID / _CHANNEL_ID / _OWNER_ID
#            IDENTYCLAW_TELEGRAM_OWNER_ID
# Telegram: ./identyclaw.sh set-telegram-token agent-namenotset  (@BotFather bot token)
# Discord/Telegram DMs: dmPolicy is open with allowFrom ["*"] (no pairing) — set in openclaw.json on init/bootstrap.

# --- A2A + RODiT webhooks (enabled in openclaw.json on init; full config after NEAR Passport) ---
# Plugins installed on deploy: identyclaw-a2a, identyclaw-webhooks (versions pinned above).
# Ingress (after Passport): POST /a2a (RODiT JWT), POST /hooks/wake|agent (RODiT signature).
# Optional outbound peers (space-separated Passport token_id values):
A2A_PEER_AGENTS=
IDENTYCLAW_A2A_DISCOVER_PEERS_FROM_API=0
IDENTYCLAW_A2A_DYNAMIC_PEERS_FROM_JWT=0

IDENTYCLAW_NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near

AGENT_NAMENOTSET_GATEWAY_PORT=18789
AGENT_NAMENOTSET_BRIDGE_PORT=18790

# --- Required on disk (not in env.local) — after deploy + Passport purchase ---
# 1. Deploy installs openclaw-identyclaw plugin; then:
#    ./identyclaw.sh generate-near-account agent-namenotset
# 2. Purchase Passport: https://purchase.identyclaw.com (use implicit_account_id from step 1)
# Passport JSON: agents/agent-namenotset/secrets/near-credentials/<implicit-account-id-not-set>.json
# Passport metadata.webhook_url = https://agent-domain-not-set.example.com:9443
# LLM API key: ./identyclaw.sh set-api-key agent-namenotset  (stored in agents/<id>/.env as OPENROUTER_API_KEY)
# Migadu password: ./identyclaw.sh set-password agent-namenotset
