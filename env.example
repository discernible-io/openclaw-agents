# Template for host runtime config — NOT read from the git checkout.
#
#   ./identyclaw.sh init
# creates ~/identyclaw-agents-app/env.local from this file (chmod 600).
# Override app root: export IDENTYCLAW_APP_DIR=/path/to/identyclaw-agents-app

# OpenClaw image from GHCR (see https://github.com/openclaw/openclaw/pkgs/container/openclaw)
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.5.27-slim
# Must match the gateway tag in OPENCLAW_BASE_IMAGE (used to pin bundled Discord).
OPENCLAW_GATEWAY_VERSION=2026.5.27
OPENCLAW_LOCAL_IMAGE=localhost/openclaw-himalaya:local
# npm specs baked into the image (seeded into each agent on first start)
# Comma/space-separated plugins baked into the image (see Containerfile.himalaya).
# Per-agent integrations installed on start (see workspace/IDENTYCLAW.md):
#   ClawHub skill:  identyclaw  → https://clawhub.ai/identyclaw/identyclaw
#   IdentyClaw plugin: git clone IDENTYCLAW_PLUGIN_REPO (deploy-pod.sh / ./identyclaw.sh upgrade-plugins)
#   ClawHub fallback:  clawhub:@identyclaw/openclaw-identyclaw-plugin
#   A2A plugin:     git clone A2A_PLUGIN_REPO (when secrets/near-credentials/*.json exists)
# Pin Discord to OPENCLAW_GATEWAY_VERSION (bare @openclaw/discord is auto-pinned at image build).
OPENCLAW_BUNDLED_PLUGINS=@openclaw/discord@2026.5.27

# Himalaya CLI release (https://github.com/pimalaya/himalaya/releases)
HIMALAYA_VERSION=v1.2.0

# Migadu mailboxes on identyclaw.com
AGENT_A_EMAIL=agent-a@identyclaw.com
AGENT_B_EMAIL=agent-b@identyclaw.com
AGENT_C_EMAIL=agent-c@identyclaw.com
AGENT_A_DISPLAY_NAME="Identyclaw Agent A"
AGENT_B_DISPLAY_NAME="Identyclaw Agent B"
AGENT_C_DISPLAY_NAME="Identyclaw Agent C"

# Mailbox passwords (or leave empty and set via ./identyclaw.sh set-password agent-a)
AGENT_A_PASSWORD=
AGENT_B_PASSWORD=
AGENT_C_PASSWORD=

# Optional Instagram credentials (synced to secrets/ on bootstrap; agent-c manages Mundo En Blanco)
# AGENT_C_INSTAGRAM_USERNAME=mundo_en_blanco
# AGENT_C_INSTAGRAM_PASSWORD=

# Host publish for standalone dev (identyclaw.sh start). Production pod uses nginx TLS.
PUBLISH_HOST=127.0.0.1

# --- App layout (all runtime config + secrets live here, not in the repo) ---
# IDENTYCLAW_APP_DIR=          # default: ~/identyclaw-agents-app
# IDENTYCLAW_AGENT_STATE_ROOT= # default: ${IDENTYCLAW_APP_DIR}/agents

# --- Deploy mode: standalone (identyclaw.sh start) or pod (nginx TLS ingress) ---
IDENTYCLAW_DEPLOY_MODE=standalone
# Agents to provision in pod deploy (scripts/deploy-pod.sh, CI). Omit agent-b/c on single-agent hosts.
# AGENT_IDS=agent-a
# Production pod — uncomment and set IDENTYCLAW_INGRESS_PORT (9443 for main and development for now):
# IDENTYCLAW_DEPLOY_MODE=pod
IDENTYCLAW_INGRESS_PORT=9443
# agent-a.identyclaw.com (must match nginx server_name; same for main and development for now)
AGENT_A_PUBLIC_HOST=agent-a.identyclaw.com
AGENT_B_PUBLIC_HOST=agent-b.identyclaw.com
AGENT_C_PUBLIC_HOST=agent-c.identyclaw.com
# Optional per-agent ingress port (defaults to IDENTYCLAW_INGRESS_PORT). Use when agents share a host on different tiers.
# AGENT_B_INGRESS_PORT=9443
# AGENT_C_INGRESS_PORT=4443

# Podman network for agent-to-agent traffic (Control UI stays on 127.0.0.1)
IDENTYCLAW_NETWORK=identyclaw-net

# A2A peer group (space-separated agent ids; requires secrets/near-credentials/*.json per agent)
A2A_PEER_AGENTS=agent-a agent-b
# A2A IDC fork repo (cloned and built on first start when near-credentials exist)
A2A_PLUGIN_REPO=https://github.com/discernible-io/openclaw-a2a-idc-plugin.git
IDENTYCLAW_PLUGIN_REPO=https://github.com/discernible-io/openclaw-identyclaw-plugin.git
# IdentyClaw API issuer for inbound JWT validation (synced to openclaw.json on bootstrap)
IDENTYCLAW_API_BASE_URL=https://api.identyclaw.com
# ClawHub fallback when GitHub build is unavailable on first start
IDENTYCLAW_CLAWHUB_PLUGIN=clawhub:@identyclaw/openclaw-identyclaw-plugin
IDENTYCLAW_CLAWHUB_SKILL=identyclaw

# TLS for pod ingress: ./identyclaw.sh generate-certs (self-signed; SANs from AGENT_*_PUBLIC_HOST).
# Mutual auth uses RODiT JWT — not TLS client certificates. Peers may use curl -k or skip TLS verify.

# Public HTTPS base URLs for Control UI + A2A behind nginx (set when IDENTYCLAW_DEPLOY_MODE=pod).
# Webhook URLs use the same host: https://<AGENT_*_PUBLIC_HOST>:<INGRESS_PORT>/hooks/wake|agent|name
# Register webhook_url in RODiT metadata as https://<AGENT_*_PUBLIC_HOST>:9443 (main) or :4443 (dev).
# Example: https://agent-a.identyclaw.com:9443
AGENT_A_A2A_PUBLIC_BASE_URL=
AGENT_B_A2A_PUBLIC_BASE_URL=
AGENT_C_A2A_PUBLIC_BASE_URL=

# NEAR Passport (RODiT) — place implicit-account JSON in either:
#   ~/identyclaw-agents-app/secrets/<implicit_account_id>.json
#   ~/identyclaw-agents-app/agents/<id>/secrets/near-credentials/<implicit_account_id>.json
# Bootstrap syncs each agent .env automatically:
#   IDENTYCLAW_ACCOUNT_ID, IDENTYCLAW_NEAR_PRIVATE_KEY, IDENTYCLAW_BASE_URL
#   NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
#   RODIT_NEAR_CREDENTIALS_SOURCE=file
#   NEAR_CREDENTIALS_FILE_PATH=/home/node/.openclaw/secrets/near-credentials/<implicit_account_id>.json
# IDENTYCLAW_NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
# When A2A is enabled, bootstrap also sets LOG_LEVEL=error and
# SUPPRESS_NO_CONFIG_WARNING=true to keep @rodit/rodit-auth-be JSON off the chat TUI.
# Dev peers with self-signed TLS: outbound.tlsSkipVerify=true or A2A_TLS_SKIP_VERIFY=1

# Ports (must differ per agent)
# Standalone dev: AGENT_*_GATEWAY_PORT is the host publish port (identyclaw.sh start).
# Pod mode: public HTTPS ingress uses IDENTYCLAW_INGRESS_PORT (9443 main / 4443 dev);
# gateways listen on pod-internal 18789/18791/18793 — nginx proxies :9443 → :18789, etc.
AGENT_A_GATEWAY_PORT=18789
AGENT_A_BRIDGE_PORT=18790
AGENT_B_GATEWAY_PORT=18791
AGENT_B_BRIDGE_PORT=18792
AGENT_C_GATEWAY_PORT=18793
AGENT_C_BRIDGE_PORT=18794
