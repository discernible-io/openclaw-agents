{
  "id": "rodit-webhooks",
  "name": "RODiT Webhooks",
  "description": "Inbound OpenClaw webhooks with RODiT Ed25519 origin signatures (x-signature + x-timestamp)",
  "contracts": {
    "tools": ["send_rodit_webhook"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoints": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Webhook paths to expose (default: /hooks/wake, /hooks/agent)"
      },
      "logLevel": {
        "type": "string",
        "description": "Winston log level for @rodit/rodit-auth-be (default error)"
      }
    }
  }
}
