{
  "plugins": {
    "allow": ["identyclaw-tools"],
    "entries": {
      "identyclaw-tools": {
        "enabled": true,
        "config": {
          "baseUrl": "https://api.identyclaw.com",
          "accountid": "YOUR_64_CHAR_HEX_NEAR_IMPLICIT_ACCOUNT_ID",
          "nearPrivateKey": "ed25519:YOUR_BASE58_PRIVATE_KEY"
        }
      }
    }
  },
  "tools": {
    "allow": [
      "identyclaw_list_agents",
      "identyclaw_list_resources",
      "identyclaw_get_resource",
      "identyclaw_get_my_identity",
      "identyclaw_get_nonce",
      "identyclaw_verify_hola"
    ]
  }
}
