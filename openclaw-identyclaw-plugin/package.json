{
  "name": "@identyclaw/openclaw-identyclaw-plugin",
  "version": "1.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "OpenClaw plugin exposing identyclaw API tools",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "scripts"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "prepare:publish": "node ./scripts/prepare-publish.mjs",
    "prepublishOnly": "npm run build && npm run prepare:publish",
    "smoke:test": "node ./scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.27"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "openclaw": "2026.5.27"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.27",
      "minGatewayVersion": "2026.5.27"
    },
    "build": {
      "openclawVersion": "2026.5.27",
      "pluginSdkVersion": "2026.5.27"
    }
  }
}
