{
  "id": "identyclaw-tools",
  "name": "identyclaw Tools",
  "description": "Tool plugin for identyclaw API",
  "contracts": {
    "tools": [
      "identyclaw_list_agents",
      "identyclaw_get_my_identity",
      "identyclaw_get_nonce",
      "identyclaw_verify_hola",
      "identyclaw_list_resources",
      "identyclaw_get_resource"
    ]
  },
  "toolMetadata": {
    "identyclaw_get_my_identity": {
      "optional": true
    },
    "identyclaw_get_nonce": {
      "optional": true
    },
    "identyclaw_verify_hola": {
      "optional": true
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "https://api.identyclaw.com"
      },
      "accountid": {
        "type": "string",
        "description": "64-char hex NEAR implicit account id"
      },
      "roditid": {
        "type": "string",
        "description": "Deprecated alias for accountid; use accountid instead"
      },
      "nearPrivateKey": {
        "type": "string",
        "description": "NEAR private key value, usually prefixed with ed25519:"
      }
    },
    "required": [
      "baseUrl"
    ]
  }
}
