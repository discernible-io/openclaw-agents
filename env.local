# Copy to env.local and fill in (chmod 600 env.local). Never commit env.local.
#
# cp env.example env.local && chmod 600 env.local

# OpenClaw image from GHCR (see https://github.com/openclaw/openclaw/pkgs/container/openclaw)
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.5.27-slim
OPENCLAW_BUNDLED_PLUGINS=@openclaw/discord
OPENCLAW_LOCAL_IMAGE=localhost/openclaw-himalaya:local

# Himalaya CLI release (https://github.com/pimalaya/himalaya/releases)
HIMALAYA_VERSION=v1.2.0

# Migadu mailboxes on agenthood.me
AGENT_A_EMAIL=juanelo@agenthood.me
AGENT_B_EMAIL=archimedes@agenthood.me
AGENT_C_EMAIL=agent-c@identyclaw.com
AGENT_A_DISPLAY_NAME="Juanelo"
AGENT_B_DISPLAY_NAME="Archimedes"
AGENT_C_DISPLAY_NAME="Agent C"

# Mailbox passwords (or leave empty and set via ./identyclaw.sh set-password agent-a)
AGENT_A_PASSWORD=
AGENT_B_PASSWORD=
AGENT_C_PASSWORD=

# Host publish (keep 127.0.0.1 unless you know you need LAN exposure)
PUBLISH_HOST=127.0.0.1

# Ports (must differ per agent)
AGENT_A_GATEWAY_PORT=18789
AGENT_A_BRIDGE_PORT=18790
AGENT_B_GATEWAY_PORT=18791
AGENT_B_BRIDGE_PORT=18792
AGENT_C_GATEWAY_PORT=18793
AGENT_C_BRIDGE_PORT=18794
